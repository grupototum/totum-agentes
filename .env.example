# Copie para .env e preencha. .env nunca é commitado.

# Keycloak (loopback na VPS)
KEYCLOAK_ISSUER=http://127.0.0.1:8180/realms/totum
KEYCLOAK_CLIENT_ID=agentes-ui
KEYCLOAK_REDIRECT_URI=http://127.0.0.1:3003/api/auth/callback
KEYCLOAK_POST_LOGOUT_URI=http://127.0.0.1:3003/login

# Postgres dedicado :5436
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5436/agentes

# openclaw-gateway loopback
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME

# Cookie session (gerar via: openssl rand -base64 48)
SESSION_SECRET=CHANGE_ME_BASE64_48

# Public origin (para callback OAuth)
APP_ORIGIN=http://127.0.0.1:3003
